# Отклик: заполни значения после знака =. Кавычки не нужны.
# Сначала заполни этот файл, затем выполни: npm run setup
# Команда спросит пароль для входа на сайт и сама создаст технические ключи.

# 1. Ссылка на твою MongoDB. Вставь целиком, с логином и паролем.
# Пример формата: mongodb+srv://логин:пароль@твой-кластер/otklik
MONGODB_URI=

# 2. Ключ из личного кабинета ProxyAPI (https://console.proxyapi.ru).
PROXYAPI_KEY=

# 3. Модель ИИ. Можно оставить выбранную; менять необязательно.
AI_MODEL=openai/gpt-4.1-mini

# 4. Эти два значения возьми на https://my.telegram.org/apps.
# Здесь не номер телефона и не код входа! Номер и код вводятся потом на сайте.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 5. Адрес приложения. Для проверки на компьютере оставь как есть.
# При запуске на VPS замени на https://твой-домен (без / в конце).
APP_ORIGIN=http://localhost:5173

# 6. Только для VPS: твой домен без https://. Локально оставь пустым.
DOMAIN=
